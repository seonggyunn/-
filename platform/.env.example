# 로컬: 아래 두 값만 선택적으로 설정. 실비밀은 이 파일에 입력하지 마세요.
LOCAL_DB_PATH=.data/operations.sqlite
PRIVATE_STORAGE_PATH=.data/private
CHROMIUM_PATH=/usr/bin/chromium
PUBLIC_ORG_ID=agency
APP_URL=
APP_HOST=127.0.0.1
TRUST_PROXY_HEADERS=false
# 운영: Supabase PostgreSQL의 서버 전용 연결 주소. 브라우저에 노출하지 않음.
DATABASE_URL=
# 알림: 본인 계정·검증된 발신 주소가 있을 때만 설정. 없으면 PREVIEW.
ADMIN_NOTIFICATION_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
# 선택 AI. 없으면 로컬 템플릿. 고객 데이터 전송은 사전 합의 필요.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# 관리자 생성 시에만 사용. ADMIN_PASSWORD가 없으면 임의 비밀번호를 비공개 파일로 생성.
ADMIN_EMAIL=
ADMIN_NAME=운영 관리자
ADMIN_ROLE=admin
ADMIN_ORG_ID=agency
ADMIN_PASSWORD=
